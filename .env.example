# Copy to .env.local for local development. All of these are optional locally.

# Postgres connection string. On Vercel this is added automatically when you
# attach a Neon (or any Postgres) database from the Storage tab.
# Without it the app runs an embedded database: in-memory on Vercel (demo mode),
# saved to ./.pglite on your own machine.
DATABASE_URL=

# The shared team password. Required as soon as DATABASE_URL is set.
DASHBOARD_PASSWORD=

# Optional. Random string used to sign login cookies. If left empty it is
# derived from DASHBOARD_PASSWORD. Set one to keep sessions valid when the
# password changes.
SESSION_SECRET=
